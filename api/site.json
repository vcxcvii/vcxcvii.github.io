---
layout: none
permalink: /api/site.json
---
{% assign mcp_pages = site.pages | where: "mcp", true %}
{
  "generated": "{{ site.time | date_to_xmlschema }}",
  "posts": [
    {% for post in site.posts %}
    {
      "type": "post",
      "title": {{ post.title | jsonify }},
      "slug": {{ post.slug | jsonify }},
      "url": {{ post.url | absolute_url | jsonify }},
      "date": {{ post.date | date: "%Y-%m-%d" | jsonify }},
      "tags": {{ post.tags | jsonify }},
      "excerpt": {{ post.excerpt | strip_html | strip | jsonify }},
      "content": {{ post.content | strip_html | strip | jsonify }}
    }{% unless forloop.last %},{% endunless %}
    {% endfor %}
  ],
  "pages": [
    {% for page in mcp_pages %}
    {%- assign slug = page.url | remove_first: "/" | split: "/" | join: "/" -%}
    {%- if slug == "" %}{% assign slug = "home" %}{% endif -%}
    {%- assign body = page.content | strip_html | strip -%}
    {%- if body == "" -%}
      {%- if page.tag -%}
        {%- assign listing = site.tags[page.tag] -%}
      {%- elsif slug == "home" or slug == "blog" -%}
        {%- assign listing = site.posts -%}
      {%- else -%}
        {%- assign listing = empty -%}
      {%- endif -%}
      {%- capture body -%}
{{ page.intro }}
{% for p in listing %}- {{ p.title }} ({{ p.date | date: "%Y-%m-%d" }}) {{ p.url | absolute_url }}: {{ p.excerpt | strip_html | strip | truncate: 240 }}
{% endfor %}
      {%- endcapture -%}
      {%- assign body = body | strip -%}
    {%- endif -%}
    {
      "type": "page",
      "title": {{ page.title | jsonify }},
      "slug": {{ slug | jsonify }},
      "url": {{ page.url | absolute_url | jsonify }},
      "intro": {{ page.intro | default: "" | jsonify }},
      "content": {{ body | jsonify }}
    }{% unless forloop.last %},{% endunless %}
    {% endfor %}
  ]
}
